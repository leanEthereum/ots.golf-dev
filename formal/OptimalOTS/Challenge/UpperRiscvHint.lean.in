import OptimalOTS.RiscvHint

/-! Upper bound in hinted RISC-V cycles: an OTS and a machine image implementing its verifier
on prover-chosen views (`RiscvHint.lean`). -/

namespace OptimalOTS.Challenge.UpperRiscvHint

/-- The OTS, the machine image, the view-to-signature projection, the honest prover's expansion
and the honest run's fuel. -/
noncomputable def submission : RiscvHint.Submission := sorry

/-- Admissibility and strong security of the OTS, a valid image, agreement of the honest
prover's run with the verifier, soundness against every view, and at most `{{CLAIM}}` cycles
on every accepting execution. -/
theorem certificate : submission.Certificate {{CLAIM}} := sorry

/-- Instructions and embedded data together occupy strictly less than 1 MiB. -/
theorem image_size : submission.image.byteSize < 1048576 := sorry

end OptimalOTS.Challenge.UpperRiscvHint
